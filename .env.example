MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=POC
# LLM: Grove gateway only (no fallback to a personal Anthropic key)
GROVE_BASE_URL=<gateway-base-url>
GROVE_API_KEY=<gateway-api-key>
# GROVE_API_KEY_SECONDARY=<optional-second-key>
# ANTHROPIC_MODEL=claude-sonnet-5-5
# REVIEWS_MODEL=claude-sonnet-5-5
# GROVE_TIMEOUT_SECONDS=30
# GROVE_RETRIES=2
# GROVE_MODEL_FALLBACKS=
AI_MAX_CONCURRENCY=4
AGENT_RECURSION_LIMIT=12
CHECKPOINT_TTL_DAYS=30
MONGODB_MAX_POOL_SIZE=50
MONGODB_APP_RETRIES=1
# Optional tracing (fail-open)
# LANGFUSE_PUBLIC_KEY=<pk>
# LANGFUSE_SECRET_KEY=<sk>
# LANGFUSE_HOST=<langfuse-url>
